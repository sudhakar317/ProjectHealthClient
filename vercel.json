{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://projecthealth-j7sq.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://projecthealth-j7sq.onrender.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://projecthealth-j7sq.onrender.com/login/oauth2/:path*" },
    { "source": "/logout", "destination": "https://projecthealth-j7sq.onrender.com/logout" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
